2  pragma solidity ^0.8.0;

3  contract BankAccount {

4      uint public balance;

5      // Deposit money
6      function deposit() public payable {
7          require(msg.value > 0, "Enter some Ether");
8          balance = balance + msg.value;
9      }

10     // Withdraw money
11     function withdraw(uint amount) public {
12         require(amount > 0, "Amount must be greater than zero");
13         require(amount <= balance, "Insufficient balance");

14         balance = balance - amount;

15         (bool success, ) = payable(msg.sender).call{value: amount}("");
16         require(success, "Transfer failed");
17     }

18     // Show balance
19     function showBalance() public view returns (uint) {
20         return balance;
21     }
22 }
